# `pyproject.toml` no tiene un runner de tareas nativo (no hay un equivalente
# real al "scripts" de package.json — [project.scripts] sólo declara entry
# points del PAQUETE instalado, no tareas de desarrollo). Las tareas del
# proyecto (lint, typecheck, test, build, verify, y las de docker/db) viven en
# `Makefile` (`templates/profiles/python/Makefile.template`), a un nivel de
# arriba de este archivo — `make` viene preinstalado en cualquier imagen base
# de CI y en cualquier máquina *nix, así que no suma una dependencia nueva.
# Ver `Makefile` para `make verify`, `make db-up`, `make db-down`,
# `make db-reset`, `make db-wait`.
[project]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
description = "{{PROJECT_DESCRIPTION}}"
requires-python = ">=3.12"
dependencies = [
    # Stack HTTP mínimo si tu proyecto expone una API. Si es una librería sin
    # servidor, borrá estas tres y dejá solo las dependencias de dominio reales.
    "fastapi>=0.115",
    "pydantic>=2",
    # FastAPI no es un servidor: sin uvicorn, no hay forma de servir la app.
    "uvicorn[standard]>=0.30",
]

[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov>=5",
    # Opcional: property-based testing. Vale la pena en dominios con muchas
    # invariantes (cálculos, parsers, máquinas de estado) donde escribir casos a
    # mano no cubre los bordes reales. Si tu proyecto no los tiene, borrala.
    "hypothesis>=6",
    "ruff>=0.8",
    "mypy>=1.11",
    "build>=1.5.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{PROJECT_PACKAGE}}"]

# Los datos NO-PYTHON que tu código importa en tiempo de ejecución (parámetros de
# configuración, tablas de referencia, plantillas) tienen que declararse ACÁ,
# explícitamente, o el wheel se instala y arranca sin ellos — el fallo aparece
# recién en la primera operación real que los necesite, no antes.
# Ejemplo (borrar o reemplazar por tus rutas reales):
# [tool.hatch.build.targets.wheel.force-include]
# "config/parametros" = "{{PROJECT_PACKAGE}}/datos/parametros"

[tool.ruff]
target-version = "py313"
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
# E,F,W: higiene base (pycodestyle + pyflakes). I: orden de imports. UP: moderniza
# sintaxis (pyupgrade). B: bugs comunes (bugbear). SIM: simplifica patrones
# redundantes. RUF: reglas propias de Ruff.
#
# ADVERTENCIA (no ocultarla): Ruff NO tiene una regla genérica que prohíba `float`
# como tipo de anotación o literal. RUF incluye un par de reglas puntuales sobre
# floats (comparación de igualdad, construcción de Decimal desde un literal float),
# pero la prohibición dura de "nunca `float` para dinero" — si tu dominio maneja
# dinero — necesita un checker de AST propio; no viene con esta selección.
select = ["E", "F", "W", "I", "UP", "B", "SIM", "RUF"]

[tool.mypy]
python_version = "3.13"
warn_unused_configs = true
warn_redundant_casts = true
warn_unused_ignores = true
ignore_missing_imports = true

# Restricción dura: el paquete de DOMINIO se tipa en modo estricto. El resto de
# src/ (aplicación, infraestructura) se tipa normal — expandí este override si esas
# capas empiezan a acumular lógica de negocio real, no lo dejes fijo para siempre.
[[tool.mypy.overrides]]
module = "{{PROJECT_PACKAGE}}.dominio.*"
strict = true

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
pythonpath = ["."]
strict_markers = true
markers = [
    "lento: pruebas que no corren en el bucle rápido de TDD (usar -m \"not lento\" para excluirlas)",
    # Tests que necesitan Postgres/Redis REALES (ver templates/docker/) — no un
    # mock. `make test` los excluye (bucle rápido); `make test-integration` los
    # corre en exclusiva, DESPUÉS de `make db-up`. El equivalente TypeScript es
    # `test:integration` como tarea de Turbo separada — acá, sin un monorepo
    # que separe paquetes, la separación se hace por marcador.
    "integracion: pruebas contra infraestructura real en contenedor (usar -m integracion para correrlas solas)",
]
# El umbral de cobertura NO va acá, a propósito. Con `--cov-fail-under` en
# `addopts`, correr un subconjunto (`pytest tests/dominio`) sale con exit 1 aunque
# todos los tests pasen — la cobertura parcial nunca llega al umbral global. En TDD
# estricto se corre un archivo a la vez, cientos de veces por sesión: el equipo
# terminaría desactivando el gate completo para no ver ese falso rojo constante, y
# ahí se pierde la red de seguridad. El umbral se exige en el comando de build/CI:
#   uv run pytest --cov-fail-under=85
addopts = "--cov={{PROJECT_PACKAGE}} --cov-report=term-missing"

[tool.coverage.run]
source = ["src/{{PROJECT_PACKAGE}}"]

[tool.coverage.report]
exclude_also = [
    "if TYPE_CHECKING:",
]
