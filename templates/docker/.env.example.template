# ==============================================================================
# {{PROJECT_NAME}} — variables que consumen docker-compose.dev.yml y
# docker-compose.yml (ambos, mismo archivo).
#
# CÓMO SE USA
#   cp docker/.env.example docker/.env      # una sola vez, después de clonar
#   # editá docker/.env si algún puerto choca con algo que ya tenés corriendo
#   docker compose -f docker/docker-compose.dev.yml --env-file docker/.env up -d
#
# `docker/.env` NO se commitea (agregalo a .gitignore si tu bootstrap no lo
# hizo ya) — son credenciales de desarrollo, no de producción, pero igual no
# tienen nada que hacer en el historial de Git. Este archivo `.env.example`
# SÍ se commitea: es la lista documentada de qué hace falta configurar.
# ==============================================================================

# Nombre del proyecto. Prefija el nombre del proyecto Compose y el de los
# volúmenes (ver el `name:` y `volumes:` de docker-compose.dev.yml) para que
# dos proyectos de este kit, del mismo autor, en la misma máquina, no
# colisionen en contenedores ni en volúmenes de datos.
PROJECT_NAME={{PROJECT_NAME}}

# ── Puertos publicados en el HOST ────────────────────────────────────────────
# No estándar a propósito: el puerto de fábrica de cada motor (5432, 6379) es
# justo el que más probablemente ya esté ocupado por una instalación nativa
# o por otro proyecto. Si el valor de acá choca con algo en tu máquina,
# cambialo — es un número, no una decisión de arquitectura.
DB_PORT=55432
DB_TEST_PORT=55433
REDIS_PORT=56379

# Puerto que expone el contenedor de la app en docker-compose.yml (el mismo
# {{CONTAINER_PORT}} que declara build-push.yml.template para el smoke test).
APP_PORT={{CONTAINER_PORT}}

# ── Credenciales de DESARROLLO/TEST — NUNCA las de producción ───────────────
# Estas credenciales viajan en texto plano en este archivo y en las variables
# de entorno de contenedores locales. Eso es aceptable PORQUE son de
# desarrollo/test: no protegen nada real. Las de producción viven en el
# secret store del proyecto (ver docs/SEGURIDAD.md), nunca acá.
DB_USER={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}
DB_NAME={{DB_NAME}}

# ── Imágenes — versión FIJADA, nunca `latest` ───────────────────────────────
# Estos dos valores TIENEN que coincidir con {{DB_IMAGE}} de
# templates/github/workflows/ci.yml.template (y con lo que diga docs/STACK.md).
# Si divergen, "funciona en mi local" deja de significar nada: estás
# probando contra una versión de motor distinta de la que corre en CI.
DB_IMAGE={{DB_IMAGE}}
REDIS_IMAGE={{REDIS_IMAGE}}

# ── Cadenas de conexión para el código que corre FUERA de Docker ───────────
# Es decir: `pnpm dev` / `uv run uvicorn ...` en tu shell, conectándose a los
# contenedores de docker-compose.dev.yml a través del puerto PUBLICADO en el
# host (arriba). Esto es DISTINTO de las que arma docker-compose.yml para el
# contenedor de la app (esas usan el nombre de servicio `db`/`redis` y el
# puerto INTERNO 5432/6379, no estos valores) — ver el comentario en
# docker-compose.yml sobre por qué son dos rutas distintas.
DATABASE_URL=postgresql://{{DB_USER}}:{{DB_PASSWORD}}@localhost:55432/{{DB_NAME}}
DATABASE_TEST_URL=postgresql://{{DB_USER}}:{{DB_PASSWORD}}@localhost:55433/{{DB_NAME}}
REDIS_URL=redis://localhost:56379

# Si cambiás DB_PORT / DB_TEST_PORT / REDIS_PORT arriba, actualizá también los
# puertos de estas tres URLs — un archivo .env plano no puede referenciar sus
# propias variables de forma portable entre parsers, así que quedan
# duplicados a propósito. Si eso te molesta, es la señal de migrar estas
# cadenas a construirse en código a partir de las variables sueltas
# (DB_USER/DB_PASSWORD/DB_PORT/DB_NAME) en vez de vivir armadas acá.
